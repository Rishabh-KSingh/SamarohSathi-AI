# SamarohSathi AI — Environment Variables
# Copy this file to .env.local and populate with your credentials.

# Google Gemini API Key (Server-side only — never expose to client)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
